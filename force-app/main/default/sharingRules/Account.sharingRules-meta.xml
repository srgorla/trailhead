<?xml version="1.0" encoding="UTF-8" ?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>PublicActiveFinancialInstitutions</fullName>
        <accessLevel>Read</accessLevel>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>Publicly_Listed__c</field>
            <operation>equals</operation>
            <value>true</value>
        </criteriaItems>
        <criteriaItems>
            <field>Institution_Status__c</field>
            <operation>equals</operation>
            <value>Active</value>
        </criteriaItems>
        <description
    >Share only active, publicly listed financial institution Account records with the fifinderapp guest user.</description>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
        <label>Public Active Financial Institutions</label>
        <sharedTo>
            <guestUser>fifinderapp</guestUser>
        </sharedTo>
    </sharingGuestRules>
</SharingRules>
